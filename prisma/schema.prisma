generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PermissionType {
  NONE 
  READ
  WRITE
}

model Invite {
  id            String     @id @default(cuid())
  permission    PermissionType

  userId        String
  documentId    String
  invitedById   String

  user          User      @relation(fields: [userId], references: [userId])
  document      Document  @relation(fields: [documentId], references: [documentId])
  invitedBy     User      @relation("InviteSender", fields: [invitedById], references: [userId])

  @@unique([userId, documentId])
}

model User {
  userId       String      @id @default(cuid())

  userName     String      @unique @db.VarChar(30) // max 30 characters long
  passwordHash String
  email         String
  
  bio           String      @db.VarChar(200) // max 200 characters long
  createdAt     DateTime    @default(now())

  createdDocs   Document[] @relation("DocumentCreator")
  invites       Invite[]
  sentInvites   Invite[]   @relation("InviteSender")
  // friends?
}


model Document {
  documentId     String     @id @default(cuid())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  title      String
  content    String

  isPinned   Boolean    @default(false)
  

  creatorId  String
  creator    User       @relation("DocumentCreator", fields: [creatorId], references: [userId])
  invites    Invite[]
}